@model Notification
@using CoreBlog.Areas.Admin.Controllers
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Neuer Hinweis" : "Hinweis bearbeiten";
}
<div class="card-x narrow">
    <div class="body">
        <form asp-action="@(isNew ? "Create" : "Edit")" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label class="form-label" asp-for="Type">Titel</label>
                <input class="form-control" asp-for="Type" maxlength="60" />
                <span class="field-validation-error" asp-validation-for="Type"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Details">Text</label>
                <textarea class="form-control" asp-for="Details" rows="4" maxlength="500"></textarea>
                <span class="field-validation-error" asp-validation-for="Details"></span>
            </div>
            <fieldset class="mb-3">
                <legend class="form-label">Symbol</legend>
                <div class="icon-choice">
                    @foreach (var (icon, label) in NotificationController.Icons)
                    {
                        <label title="@label"><input type="radio" name="TypeSymbol" value="@icon" @(Model.TypeSymbol == icon ? "checked" : null) /><i class="@icon"></i><span class="visually-hidden">@label</span></label>
                    }
                </div>
            </fieldset>
            <div class="mb-3">
                <label class="form-label" asp-for="SymbolColor">Farbe</label>
                <input class="form-control form-control-color color-input" asp-for="SymbolColor" type="color" />
            </div>
            <div class="switch-row form-switch">
                <label class="form-check-label" for="Status"><strong>Aktiv</strong><br /><span class="form-text">Aktive Hinweise sehen alle Autoren auf ihrem Dashboard.</span></label>
                <input class="form-check-input" type="checkbox" role="switch" asp-for="Status" />
            </div>
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-ink" type="submit">@(isNew ? "Hinweis veröffentlichen" : "Änderungen speichern")</button>
                <a class="btn btn-ghost" asp-action="Index">Abbrechen</a>
            </div>
        </form>
    </div>
</div>

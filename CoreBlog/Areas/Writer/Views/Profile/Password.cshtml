@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Passwort ändern";
    bool isDemo = ViewBag.IsDemoAccount == true;
}
<div class="toolbar">
    <nav class="tabs-x"><a asp-action="Index">Profil</a><a class="is-active" asp-action="Password">Passwort</a></nav>
</div>
<div class="card-x narrow">
    <div class="body">
        @if (isDemo)
        {
            <div class="notice"><i class="fa-solid fa-lock mt-1"></i><span>Im Demo-Konto ist das Ändern des Passworts gesperrt, damit die Demo für alle Besucher erreichbar bleibt. In einem eigenen Konto funktioniert es normal.</span></div>
        }
        <form asp-action="Password" method="post" novalidate class="@(isDemo ? "mt-3" : null)">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <fieldset @(isDemo ? "disabled" : null)>
                <div class="mb-3">
                    <label class="form-label" asp-for="CurrentPassword">Aktuelles Passwort</label>
                    <input class="form-control" asp-for="CurrentPassword" autocomplete="current-password" />
                    <span class="field-validation-error" asp-validation-for="CurrentPassword"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="NewPassword">Neues Passwort</label>
                    <input class="form-control" asp-for="NewPassword" autocomplete="new-password" />
                    <div class="form-text">Mindestens 8 Zeichen mit Groß- und Kleinbuchstaben und einer Ziffer.</div>
                    <span class="field-validation-error" asp-validation-for="NewPassword"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="ConfirmPassword">Neues Passwort wiederholen</label>
                    <input class="form-control" asp-for="ConfirmPassword" autocomplete="new-password" />
                    <span class="field-validation-error" asp-validation-for="ConfirmPassword"></span>
                </div>
                <button class="btn btn-ink" type="submit">Passwort ändern</button>
            </fieldset>
        </form>
    </div>
</div>

@model RegisterViewModel
@{
    ViewData["Title"] = "Registrieren";
}
<div class="auth">
    <div class="auth-art" style="background-image:url('/img/blog/7.jpg')">
        <div>
            <blockquote>„Ein gutes Portfolio erzählt eine Geschichte.“</blockquote>
            <cite>Aus „Das Portfolio, das Recruiter wirklich lesen“</cite>
        </div>
    </div>
    <div class="auth-form">
        <div class="box">
            <h1>Autor werden</h1>
            <p class="sub">Erstellen Sie ein kostenloses Konto und veröffentlichen Sie Ihren ersten Beitrag.</p>
            <form asp-action="Register" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="mb-3">
                    <label class="form-label" asp-for="FullName"></label>
                    <input class="form-control" asp-for="FullName" autocomplete="name" />
                    <span class="field-validation-error" asp-validation-for="FullName"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Email"></label>
                    <input class="form-control" asp-for="Email" autocomplete="email" />
                    <span class="field-validation-error" asp-validation-for="Email"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Password"></label>
                    <input class="form-control" asp-for="Password" autocomplete="new-password" />
                    <div class="form-text">Mindestens 8 Zeichen mit Groß- und Kleinbuchstaben und einer Ziffer.</div>
                    <span class="field-validation-error" asp-validation-for="Password"></span>
                </div>
                <div class="mb-4">
                    <label class="form-label" asp-for="ConfirmPassword"></label>
                    <input class="form-control" asp-for="ConfirmPassword" autocomplete="new-password" />
                    <span class="field-validation-error" asp-validation-for="ConfirmPassword"></span>
                </div>
                <button class="btn btn-ink btn-lg w-100" type="submit">Konto erstellen</button>
            </form>
            <p class="mt-4 text-center text-secondary">Schon registriert? <a asp-action="Login">Anmelden</a></p>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
